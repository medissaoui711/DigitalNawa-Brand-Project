<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width={{WIDTH}},height={{HEIGHT}},initial-scale=1">
  <title>DigitalNawa Motion — {{FORMAT}}</title>
  <link rel="stylesheet" href="./styles.css">
</head>
<body>
  <div id="stage" data-composition-id="{{COMPOSITION_ID}}" data-start="0" data-width="{{WIDTH}}" data-height="{{HEIGHT}}">
    <div id="pixel-layer" class="clip" data-start="0" data-duration="{{DURATION}}" data-track-index="0" aria-hidden="true"></div>
    <img id="dn-symbol" class="clip" data-start="0" data-duration="{{DURATION}}" data-track-index="1" src="./assets/dn-symbol-master.svg" alt="" aria-hidden="true">
    <p id="arabic-name" class="clip" data-start="0" data-duration="{{DURATION}}" data-track-index="2" lang="ar" dir="rtl"></p>
    <p id="english-name" class="clip" data-start="0" data-duration="{{DURATION}}" data-track-index="3" lang="en" dir="ltr"></p>
    <p id="tagline" class="clip" data-start="0" data-duration="{{DURATION}}" data-track-index="4"></p>
  </div>
  <script src="./runtime/brand-tokens.js"></script>
  <script src="./vendor/gsap.min.js"></script>
  <script src="./vendor/CustomEase.min.js"></script>
  <script src="./composition.js"></script>
</body>
</html>
